#include "stdio.h"
#include "stdint.h"
#include "PID.h"
#include "gimbal_tx.h"
#include "motor_rx.h"
#include "main.h"

volatile int16_t speed,current,temp,position;
volatile int16_t target_speed;

PID_t Speed_PID;
PID_t Position_PID;

void PID_Init(PID_t *pid, float kp, float ki, float kd) {
    pid->Kp = kp;
    pid->Ki = ki;
    pid->Kd = kd;
    pid->integral = 0.0f;
    pid->derivative = 0.0f;
    pid->prev_error = 0.0f;
}

float PID_Calc(PID_t *pid, float error) {
    pid->integral += error;
    pid->derivative =  error - pid->prev_error;
    pid->prev_error = error;
    return (pid->Kp * pid->prev_error) + (pid->Ki * pid->integral) + (pid->Kd * pid->derivative);
}


void Control_Loop(float target_speed) {

    /*float error_position = target_position - position;
    if (error_position > 4096) error_position -= 8192;
    if (error_position < -4096) error_position += 8192;

    float target_speed = PID_Calc(&Position_PID, error_position);
    if (target_speed > 300) target_speed = 300;
    if (target_speed < -300) target_speed = -300;*/

    // 2. 内环：速度环
    float error_speed = target_speed - speed;
    float target_val = PID_Calc(&Speed_PID, error_speed);
    if (target_val < -25000.f) {
        target_val = -25000.f;
    }
    if (target_val > 25000.f) {
        target_val = 25000.f;
    }

    CAN_cmd_gimbal(0, target_val, 0, 0);
}

void PID_reset(PID_t *pid){
    pid->integral = 0.0f;
    pid->prev_error = 0.0f;
    pid->derivative = 0.0f;
}
