/* USER CODE BEGIN Header_PID_control */
/**
  * @brief  Function implementing the PID thread.
  * @param  argument: Not used
  * @retval None
  */
/* USER CODE END Header_PID_control */
void PID_control(void *argument)
{
  /* USER CODE BEGIN PID_control */
  CAN_Init(&hcan1, 0);
  /* Infinite loop */
  for(;;)
  { Control_Loop(target_speed);
    osDelay(1);
  }
  /* USER CODE END PID_control */
}

/* USER CODE BEGIN Header_PWM_servo */
/**
* @brief Function implementing the servo thread.
* @param argument: Not used
* @retval None
*/
/* USER CODE END Header_PWM_servo */
void PWM_servo(void *argument)
{
  /* USER CODE BEGIN PWM_servo */
  HAL_TIM_Base_Start(&htim1);
  HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
  HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_2);
  HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_3);
  HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_4);
  __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 500);
  __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, 500);
  __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_3, 500);
  __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_4, 500);
  /* Infinite loop */
  for(;;)
  { if (KEY_state == 1) {
    osDelay(20);
    if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0) == GPIO_PIN_RESET)
    { KEY_state = 0;
      angle += distance * 222;
      __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, angle);
    }

    if (angle >= 2450)
    {
      angle = 2450;
      distance = -1;
    }
    if (angle <= 500) {
      angle = 500;
      distance = 1;
    }
  }
    osDelay(10);
  }
  /* USER CODE END PWM_servo */
}

/* USER CODE BEGIN Header_PWM_LED */
/**
* @brief Function implementing the PWM thread.
* @param argument: Not used
* @retval None
*/
/* USER CODE END Header_PWM_LED */
void PWM_LED(void *argument)
{
  /* USER CODE BEGIN PWM_LED */
  uint32_t inter = 0;
  HAL_TIM_Base_Start(&htim5);
  HAL_TIM_PWM_Start(&htim5, TIM_CHANNEL_3);
  /* Infinite loop */
  for(;;)
  { inter = HAL_GetTick() - last_feed;
    //counter = __HAL_TIM_GET_COUNTER(&htim5);
    if (inter > 1000) {
      PID_reset(&Speed_PID);
      __HAL_TIM_SET_COMPARE(&htim5, TIM_CHANNEL_3, brightness);
      brightness += direct * 30;

      if (brightness >= 30000) {
        brightness = 30000;
        direct = -1;
      }
      if (brightness < 0) {
        brightness = 0;
        direct = 1;
      }
    }else {
      __HAL_TIM_SET_COMPARE(&htim5, TIM_CHANNEL_3, 0);
    }
    osDelay(1);
  }
  /* USER CODE END PWM_LED */
}

/* USER CODE BEGIN Header_USART_motor_RX */
/**
* @brief Function implementing the USART_RX thread.
* @param argument: Not used
* @retval None
*/
/* USER CODE END Header_USART_motor_RX */
void USART_motor_RX(void *argument)
{
  /* USER CODE BEGIN USART_motor_RX */
  MX_CAN1_Init();
  CAN_Init(&hcan1, 0);
  HAL_CAN_Start(&hcan1);
  HAL_CAN_ActivateNotification(&hcan1, CAN_IT_RX_FIFO0_MSG_PENDING);
  HAL_UART_Transmit(&huart1, (uint8_t*)"Hello\r\n", 7, 1000);
  HAL_UART_Transmit_DMA(&huart1,(uint8_t*)message,strlen(message));
  /* Infinite loop */
  for(;;)
  {
    sprintf(message, "电机转速: %drpm\r\n", speed);
    HAL_UART_Transmit_DMA(&huart1,(uint8_t*)message,strlen(message));
    osDelay(2000);
  }
  /* USER CODE END USART_motor_RX */
}

